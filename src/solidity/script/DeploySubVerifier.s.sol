/*
 * DeploySubVerifier.s.sol
 *
 * Deploys the 20 UltraHonk outer-circuit proof verifiers (10 for chip IDs, 10 for IDs read by
 * camera on either platform), deploys a SubVerifier (canonical
 * contract imported from the registry-contracts package), wires the proof verifiers + their
 * vkey hashes, sets the default OPRF public key hash, and transfers admin to
 * the final ADMIN_ADDRESS. Does NOT register the SubVerifier with the RootVerifier — that
 * registration is performed by the RootVerifier admin (a Safe multisig) outside this script.
 *
 * The broadcaster is the temporary admin during deployment so it can call admin-only setup
 * functions (addProofVerifiers, setGlobalOPRFPubKeyHash). Admin is transferred to
 * ADMIN_ADDRESS at the end of the script.
 *
 * Required env vars:
 *   PRIVATE_KEY              - deployer key (becomes temporary admin)
 *   CHAIN_ID                 - chain the RPC must be on; the script reverts on a mismatch
 *   ROOT_VERIFIER_ADDRESS    - already-deployed RootVerifier this SubVerifier targets
 *   ADMIN_ADDRESS            - final admin (e.g. multisig) for the new SubVerifier
 *   SUB_VERIFIER_VERSION     - non-zero bytes32 semver key. Recorded in the addresses JSON only.
 *   GLOBAL_OPRF_PUB_KEY_HASH - non-zero protocol-default OPRF pubkey hash, passed to the
 *                              SubVerifier constructor. Salted proofs fail while it is zero.
 */

pragma solidity ^0.8.30;

import {console} from "forge-std/Script.sol";
import {DeployBase} from "./DeployBase.s.sol";
import {HonkVerifier as OuterCount4Verifier} from "../src/ultra-honk-verifiers/OuterCount4.sol";
import {HonkVerifier as OuterCount5Verifier} from "../src/ultra-honk-verifiers/OuterCount5.sol";
import {HonkVerifier as OuterCount6Verifier} from "../src/ultra-honk-verifiers/OuterCount6.sol";
import {HonkVerifier as OuterCount7Verifier} from "../src/ultra-honk-verifiers/OuterCount7.sol";
import {HonkVerifier as OuterCount8Verifier} from "../src/ultra-honk-verifiers/OuterCount8.sol";
import {HonkVerifier as OuterCount9Verifier} from "../src/ultra-honk-verifiers/OuterCount9.sol";
import {HonkVerifier as OuterCount10Verifier} from "../src/ultra-honk-verifiers/OuterCount10.sol";
import {HonkVerifier as OuterCount11Verifier} from "../src/ultra-honk-verifiers/OuterCount11.sol";
import {HonkVerifier as OuterCount12Verifier} from "../src/ultra-honk-verifiers/OuterCount12.sol";
import {HonkVerifier as OuterCount13Verifier} from "../src/ultra-honk-verifiers/OuterCount13.sol";
import {HonkVerifier as OuterAttestedIdCount2Verifier} from "../src/ultra-honk-verifiers/OuterAttestedIdCount2.sol";
import {HonkVerifier as OuterAttestedIdCount3Verifier} from "../src/ultra-honk-verifiers/OuterAttestedIdCount3.sol";
import {HonkVerifier as OuterAttestedIdCount4Verifier} from "../src/ultra-honk-verifiers/OuterAttestedIdCount4.sol";
import {HonkVerifier as OuterAttestedIdCount5Verifier} from "../src/ultra-honk-verifiers/OuterAttestedIdCount5.sol";
import {HonkVerifier as OuterAttestedIdCount6Verifier} from "../src/ultra-honk-verifiers/OuterAttestedIdCount6.sol";
import {HonkVerifier as OuterAttestedIdCount7Verifier} from "../src/ultra-honk-verifiers/OuterAttestedIdCount7.sol";
import {HonkVerifier as OuterAttestedIdCount8Verifier} from "../src/ultra-honk-verifiers/OuterAttestedIdCount8.sol";
import {HonkVerifier as OuterAttestedIdCount9Verifier} from "../src/ultra-honk-verifiers/OuterAttestedIdCount9.sol";
import {HonkVerifier as OuterAttestedIdCount10Verifier} from "../src/ultra-honk-verifiers/OuterAttestedIdCount10.sol";
import {HonkVerifier as OuterAttestedIdCount11Verifier} from "../src/ultra-honk-verifiers/OuterAttestedIdCount11.sol";
import {RootVerifier} from "@zkpassport/registry-contracts/RootVerifier.sol";
import {SubVerifier} from "@zkpassport/registry-contracts/SubVerifier.sol";
import {ProofVerifier} from "@zkpassport/registry-contracts/lib/Types.sol";

contract DeploySubVerifier is DeployBase {
  bytes32 public SUB_VERIFIER_VERSION;

  // vkey hashes for the 20 outer UltraHonk proof verifiers, in the order they are deployed:
  // outer_count_4 .. outer_count_13, outer_attested_id_count_2 .. 11.
  // Auto-generated by `src/ts/scripts/circuit-packager.ts` — do not edit by hand.
  bytes32[] public vkeyHashes = [
    // Outer (4 subproofs)
    bytes32(hex"0345a25899029830ed562e47667bb6da8c07e5355e5a4d18d7b4a0507dd1b890"),
    // Outer (5 subproofs)
    bytes32(hex"086b6104133cfce2bfc1bd89fa1c0f4d44499a6fa638ccca1842d10223e261ee"),
    // Outer (6 subproofs)
    bytes32(hex"259d9ac1c92499dffc83c15f85ace25c51e34c3fba52e0f4db94f936bc1e21b2"),
    // Outer (7 subproofs)
    bytes32(hex"17b5cc890adda9b3d4f2e278a1dc33199a66fe4547a38d066f669b6dea0d0a09"),
    // Outer (8 subproofs)
    bytes32(hex"2b231a73ce09ae03936db30861f69d2b7afef42118736b57a970bd5ef22e6b4b"),
    // Outer (9 subproofs)
    bytes32(hex"0ba9bda5ed8feb20117e04edade722d588fffc3f686873b8c18e33abbf13bb4b"),
    // Outer (10 subproofs)
    bytes32(hex"01af51387480391d39772760fc43f21e2d839a57580da51209ba193e29ef8875"),
    // Outer (11 subproofs)
    bytes32(hex"2705cc052c4e7b0f9d56d7c7ce7652e4d88e3ae4d64a27d82da69195bc5437de"),
    // Outer (12 subproofs)
    bytes32(hex"0b5cd3365308dfebd3279b7e3a36b29282f68efd405b960432dfc92fc380886c"),
    // Outer (13 subproofs)
    bytes32(hex"182060d3c0edf4ce03c8b8b4645f114ed756914dc1019ad3b85b60c3b2ce4831"),
    // Outer attested id (2 subproofs)
    bytes32(hex"01cb2a9cc9d0cdbc96253fa28828a3a74c11d368cbdd51cc19a99c040803f332"),
    // Outer attested id (3 subproofs)
    bytes32(hex"07620e594d8b5c5f63ed244cfc6f078d54fa65a28991bb9451aca0aeb8196f8e"),
    // Outer attested id (4 subproofs)
    bytes32(hex"08129558c706f96b89f22ea3ee240b38818e08d8cd1cec1fa654f6b493ffaea6"),
    // Outer attested id (5 subproofs)
    bytes32(hex"07500d8439814719e97281b8ba85e5e895fd83ba5c37c31de76345c23d592125"),
    // Outer attested id (6 subproofs)
    bytes32(hex"0de831b707a1aa1d3cd09a14ff709c5fd3742c33f71215b1b09650d961ab84b5"),
    // Outer attested id (7 subproofs)
    bytes32(hex"1d3e99515b98114c4f7e5d0189dee6052152a95e4258a9cd86bb132774d85f69"),
    // Outer attested id (8 subproofs)
    bytes32(hex"1158d74dbf37010bbe68b156b9a26bbfd783dca733eb94954aeda3c746a03410"),
    // Outer attested id (9 subproofs)
    bytes32(hex"297936906f476bc0158586ae477d235335bfc6096881a26e77fedff1a17cfc18"),
    // Outer attested id (10 subproofs)
    bytes32(hex"09a5887278f803914c95866a82cdbc1923942bec76498191ed6930a573ccf73d"),
    // Outer attested id (11 subproofs)
    bytes32(hex"2aa6bc63b3c3439fe8d312bf5580950030c9ae337f495c825f532e6333e94c4a")
  ];
  address[] public proofVerifiers = new address[](20);

  function setUp() public {}

  function run() public {
    // Validate env
    _requireChainId();
    SUB_VERIFIER_VERSION = vm.envBytes32("SUB_VERIFIER_VERSION");
    require(SUB_VERIFIER_VERSION != bytes32(0), "SUB_VERIFIER_VERSION must be set");
    address adminAddress = vm.envAddress("ADMIN_ADDRESS");
    require(adminAddress != address(0), "ADMIN_ADDRESS must be set");
    RootVerifier rootVerifier = RootVerifier(vm.envAddress("ROOT_VERIFIER_ADDRESS"));
    require(address(rootVerifier) != address(0), "ROOT_VERIFIER_ADDRESS must be set");
    bytes32 globalOPRFPubKeyHash = vm.envBytes32("GLOBAL_OPRF_PUB_KEY_HASH");
    require(globalOPRFPubKeyHash != bytes32(0), "GLOBAL_OPRF_PUB_KEY_HASH must be set");

    uint256 deployerPrivateKey = vm.envUint("PRIVATE_KEY");
    address deployer = vm.addr(deployerPrivateKey);
    vm.startBroadcast(deployerPrivateKey);

    // Deploy the outer UltraHonk proof verifiers, chip then Tier 2.
    console.log("Deploying outer proof verifiers...");
    proofVerifiers[0] = address(new OuterCount4Verifier());
    proofVerifiers[1] = address(new OuterCount5Verifier());
    proofVerifiers[2] = address(new OuterCount6Verifier());
    proofVerifiers[3] = address(new OuterCount7Verifier());
    proofVerifiers[4] = address(new OuterCount8Verifier());
    proofVerifiers[5] = address(new OuterCount9Verifier());
    proofVerifiers[6] = address(new OuterCount10Verifier());
    proofVerifiers[7] = address(new OuterCount11Verifier());
    proofVerifiers[8] = address(new OuterCount12Verifier());
    proofVerifiers[9] = address(new OuterCount13Verifier());
    proofVerifiers[10] = address(new OuterAttestedIdCount2Verifier());
    proofVerifiers[11] = address(new OuterAttestedIdCount3Verifier());
    proofVerifiers[12] = address(new OuterAttestedIdCount4Verifier());
    proofVerifiers[13] = address(new OuterAttestedIdCount5Verifier());
    proofVerifiers[14] = address(new OuterAttestedIdCount6Verifier());
    proofVerifiers[15] = address(new OuterAttestedIdCount7Verifier());
    proofVerifiers[16] = address(new OuterAttestedIdCount8Verifier());
    proofVerifiers[17] = address(new OuterAttestedIdCount9Verifier());
    proofVerifiers[18] = address(new OuterAttestedIdCount10Verifier());
    proofVerifiers[19] = address(new OuterAttestedIdCount11Verifier());
    for (uint256 i = 0; i < proofVerifiers.length; i++) {
      console.log("  outer verifier", i, "deployed at:", proofVerifiers[i]);
    }

    // Deploy the SubVerifier with the broadcaster as temporary admin.
    console.log("Deploying SubVerifier...");
    SubVerifier subVerifier = new SubVerifier(deployer, rootVerifier, globalOPRFPubKeyHash);
    console.log("SubVerifier deployed at:", address(subVerifier));

    // Wire proof verifiers (admin-only on SubVerifier).
    require(vkeyHashes.length == proofVerifiers.length, "One vkey hash per outer verifier: package the circuits");
    ProofVerifier[] memory pvArray = new ProofVerifier[](proofVerifiers.length);
    for (uint256 i = 0; i < proofVerifiers.length; i++) {
      pvArray[i] = ProofVerifier({vkeyHash: vkeyHashes[i], verifier: proofVerifiers[i]});
    }
    subVerifier.addProofVerifiers(pvArray);
    console.log("Proof verifiers added");

    // Hand admin over to the final admin (e.g. multisig).
    subVerifier.transferAdmin(adminAddress);
    console.log("Admin transferred to:", adminAddress);

    vm.stopBroadcast();

    _writeAddresses(rootVerifier, subVerifier, adminAddress);

    console.log("");
    console.log("Next: RootVerifier admin (multisig) calls addSubVerifier(version, %s)", address(subVerifier));
  }

  function _writeAddresses(RootVerifier rootVerifier, SubVerifier subVerifier, address adminAddress) internal {
    string memory versionStr = _versionString(SUB_VERIFIER_VERSION);

    // proof_verifiers object keyed by outer_count_N
    string memory pvJson = "pv";
    vm.serializeAddress(pvJson, "outer_count_4", proofVerifiers[0]);
    vm.serializeAddress(pvJson, "outer_count_5", proofVerifiers[1]);
    vm.serializeAddress(pvJson, "outer_count_6", proofVerifiers[2]);
    vm.serializeAddress(pvJson, "outer_count_7", proofVerifiers[3]);
    vm.serializeAddress(pvJson, "outer_count_8", proofVerifiers[4]);
    vm.serializeAddress(pvJson, "outer_count_9", proofVerifiers[5]);
    vm.serializeAddress(pvJson, "outer_count_10", proofVerifiers[6]);
    vm.serializeAddress(pvJson, "outer_count_11", proofVerifiers[7]);
    vm.serializeAddress(pvJson, "outer_count_12", proofVerifiers[8]);
    pvJson = vm.serializeAddress(pvJson, "outer_count_13", proofVerifiers[9]);

    // version object: { address, admin, root_verifier, proof_verifiers, deployed_at }
    string memory versionJson = "subverifier_version";
    vm.serializeAddress(versionJson, "address", address(subVerifier));
    vm.serializeAddress(versionJson, "admin", adminAddress);
    vm.serializeAddress(versionJson, "root_verifier", address(rootVerifier));
    vm.serializeUint(versionJson, "deployed_at", block.timestamp);
    versionJson = vm.serializeString(versionJson, "proof_verifiers", pvJson);

    // sub_verifier_versions: { "<version>": { ... } }
    string memory section = "sub_verifier_versions";
    section = vm.serializeString(section, versionStr, versionJson);

    _writeToAddresses("sub_verifier_versions", section);
  }

  function _versionString(bytes32 version) internal pure returns (string memory) {
    if (version == bytes32(0)) return "unversioned";
    uint256 v = uint256(version);
    return string.concat(
      vm.toString(uint16(v >> 240)), ".", vm.toString(uint16(v >> 224)), ".", vm.toString(uint16(v >> 208))
    );
  }
}
