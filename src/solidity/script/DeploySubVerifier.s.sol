/*
 * DeploySubVerifier.s.sol
 *
 * Deploys the 10 UltraHonk outer-circuit proof verifiers, deploys a SubVerifier (canonical
 * contract imported from the registry-contracts package), wires the proof verifiers + their
 * vkey hashes, sets the default OPRF public key hash, and transfers admin to
 * the final ADMIN_ADDRESS. Does NOT register the SubVerifier with the RootVerifier — that
 * registration is performed by the RootVerifier admin (a Safe multisig) outside this script.
 *
 * The broadcaster is the temporary admin during deployment so it can call admin-only setup
 * functions (addProofVerifiers, setGlobalOPRFPubKeyHash). Admin is transferred to
 * ADMIN_ADDRESS at the end of the script.
 *
 * Required env vars:
 *   PRIVATE_KEY              - deployer key (becomes temporary admin)
 *   CHAIN_ID                 - chain the RPC must be on; the script reverts on a mismatch
 *   ROOT_VERIFIER_ADDRESS    - already-deployed RootVerifier this SubVerifier targets
 *   ADMIN_ADDRESS            - final admin (e.g. multisig) for the new SubVerifier
 *   SUB_VERIFIER_VERSION     - non-zero bytes32 semver key. Recorded in the addresses JSON only.
 *   GLOBAL_OPRF_PUB_KEY_HASH - non-zero protocol-default OPRF pubkey hash, passed to the
 *                              SubVerifier constructor. Salted proofs fail while it is zero.
 */

pragma solidity ^0.8.30;

import {console} from "forge-std/Script.sol";
import {DeployBase} from "./DeployBase.s.sol";
import {HonkVerifier as OuterCount4Verifier} from "../src/ultra-honk-verifiers/OuterCount4.sol";
import {HonkVerifier as OuterCount5Verifier} from "../src/ultra-honk-verifiers/OuterCount5.sol";
import {HonkVerifier as OuterCount6Verifier} from "../src/ultra-honk-verifiers/OuterCount6.sol";
import {HonkVerifier as OuterCount7Verifier} from "../src/ultra-honk-verifiers/OuterCount7.sol";
import {HonkVerifier as OuterCount8Verifier} from "../src/ultra-honk-verifiers/OuterCount8.sol";
import {HonkVerifier as OuterCount9Verifier} from "../src/ultra-honk-verifiers/OuterCount9.sol";
import {HonkVerifier as OuterCount10Verifier} from "../src/ultra-honk-verifiers/OuterCount10.sol";
import {HonkVerifier as OuterCount11Verifier} from "../src/ultra-honk-verifiers/OuterCount11.sol";
import {HonkVerifier as OuterCount12Verifier} from "../src/ultra-honk-verifiers/OuterCount12.sol";
import {HonkVerifier as OuterCount13Verifier} from "../src/ultra-honk-verifiers/OuterCount13.sol";
import {RootVerifier} from "@zkpassport/registry-contracts/RootVerifier.sol";
import {SubVerifier} from "@zkpassport/registry-contracts/SubVerifier.sol";
import {ProofVerifier} from "@zkpassport/registry-contracts/lib/Types.sol";

contract DeploySubVerifier is DeployBase {
  bytes32 public SUB_VERIFIER_VERSION;

  // vkey hashes for the 10 outer UltraHonk proof verifiers (outer_count_4 .. outer_count_13).
  // Auto-generated by `src/ts/scripts/circuit-packager.ts` — do not edit by hand.
  bytes32[] public vkeyHashes = [
    // Outer (4 subproofs)
    bytes32(hex"1b921a06574123ec7d4944c69c56ac038bba5619641de5b5568a8c526282b506"),
    // Outer (5 subproofs)
    bytes32(hex"14765cfe42f6c72ea39d5c9be96c3e9a39b2e982ec5f0133749f88e0f00bcc27"),
    // Outer (6 subproofs)
    bytes32(hex"1db3fe60678277b68fd92e36bf1079aaa2e13d44948c8ff3ca3f68f17d940f77"),
    // Outer (7 subproofs)
    bytes32(hex"1945c33359b6f908029e7d4c7a94fe63aff78b2b539c40cfdba12968aa00640d"),
    // Outer (8 subproofs)
    bytes32(hex"26cc203a2f08ecdbe495f401ac8bd392bc6562d0c8d713f83ebe50adf20fe3f0"),
    // Outer (9 subproofs)
    bytes32(hex"1812650b42330e13d2291807e29868d43dd6d7467b79cc2fe12e63261316f59c"),
    // Outer (10 subproofs)
    bytes32(hex"2f7fa97aa54caff0afaa3add0f1513fc7721e7bb9c8a3a4293fb4fdb892dea19"),
    // Outer (11 subproofs)
    bytes32(hex"1d10802e4bb775a224b46080e0471fc95312940900c9b3af6caada1232dc4465"),
    // Outer (12 subproofs)
    bytes32(hex"0d9c40865a3e310ef4fb611b88b7ab8e6677e5046860811d94eb055f425f270c"),
    // Outer (13 subproofs)
    bytes32(hex"225962b087bcacb1ad84936372881caa97f159db21c20ffbaeee9460849806bc")
  ];
  address[] public proofVerifiers = new address[](10);

  function setUp() public {}

  function run() public {
    // Validate env
    _requireChainId();
    SUB_VERIFIER_VERSION = vm.envBytes32("SUB_VERIFIER_VERSION");
    require(SUB_VERIFIER_VERSION != bytes32(0), "SUB_VERIFIER_VERSION must be set");
    address adminAddress = vm.envAddress("ADMIN_ADDRESS");
    require(adminAddress != address(0), "ADMIN_ADDRESS must be set");
    RootVerifier rootVerifier = RootVerifier(vm.envAddress("ROOT_VERIFIER_ADDRESS"));
    require(address(rootVerifier) != address(0), "ROOT_VERIFIER_ADDRESS must be set");
    bytes32 globalOPRFPubKeyHash = vm.envBytes32("GLOBAL_OPRF_PUB_KEY_HASH");
    require(globalOPRFPubKeyHash != bytes32(0), "GLOBAL_OPRF_PUB_KEY_HASH must be set");

    uint256 deployerPrivateKey = vm.envUint("PRIVATE_KEY");
    address deployer = vm.addr(deployerPrivateKey);
    vm.startBroadcast(deployerPrivateKey);

    // Deploy the 10 UltraHonk proof verifiers.
    console.log("Deploying outer proof verifiers...");
    proofVerifiers[0] = address(new OuterCount4Verifier());
    proofVerifiers[1] = address(new OuterCount5Verifier());
    proofVerifiers[2] = address(new OuterCount6Verifier());
    proofVerifiers[3] = address(new OuterCount7Verifier());
    proofVerifiers[4] = address(new OuterCount8Verifier());
    proofVerifiers[5] = address(new OuterCount9Verifier());
    proofVerifiers[6] = address(new OuterCount10Verifier());
    proofVerifiers[7] = address(new OuterCount11Verifier());
    proofVerifiers[8] = address(new OuterCount12Verifier());
    proofVerifiers[9] = address(new OuterCount13Verifier());
    for (uint256 i = 0; i < 10; i++) {
      console.log("  outer_count_", i + 4, "deployed at:", proofVerifiers[i]);
    }

    // Deploy the SubVerifier with the broadcaster as temporary admin.
    console.log("Deploying SubVerifier...");
    SubVerifier subVerifier = new SubVerifier(deployer, rootVerifier, globalOPRFPubKeyHash);
    console.log("SubVerifier deployed at:", address(subVerifier));

    // Wire proof verifiers (admin-only on SubVerifier).
    ProofVerifier[] memory pvArray = new ProofVerifier[](10);
    for (uint256 i = 0; i < 10; i++) {
      pvArray[i] = ProofVerifier({vkeyHash: vkeyHashes[i], verifier: proofVerifiers[i]});
    }
    subVerifier.addProofVerifiers(pvArray);
    console.log("Proof verifiers added");

    // Hand admin over to the final admin (e.g. multisig).
    subVerifier.transferAdmin(adminAddress);
    console.log("Admin transferred to:", adminAddress);

    vm.stopBroadcast();

    _writeAddresses(rootVerifier, subVerifier, adminAddress);

    console.log("");
    console.log("Next: RootVerifier admin (multisig) calls addSubVerifier(version, %s)", address(subVerifier));
  }

  function _writeAddresses(RootVerifier rootVerifier, SubVerifier subVerifier, address adminAddress) internal {
    string memory section = "sub_verifier_versions";
    string memory versionStr = _versionString(SUB_VERIFIER_VERSION);
    string memory sectionJson;

    // Writing the section replaces it whole, so carry over every other version it records
    string memory addresses = _readAddresses();
    string[] memory recordedVersions = _recordedVersions(addresses, section);
    for (uint256 i = 0; i < recordedVersions.length; i++) {
      if (keccak256(bytes(recordedVersions[i])) == keccak256(bytes(versionStr))) {
        continue;
      }
      SubVerifierEntry memory recorded =
        _readSubVerifierEntry(addresses, _versionEntryPath(section, recordedVersions[i]));
      sectionJson =
        vm.serializeString(section, recordedVersions[i], _serializeSubVerifierEntry(recordedVersions[i], recorded));
    }

    SubVerifierEntry memory deployed = SubVerifierEntry({
      subVerifier: address(subVerifier),
      admin: adminAddress,
      rootVerifier: address(rootVerifier),
      deployedAt: block.timestamp,
      outerVerifiers: proofVerifiers
    });
    sectionJson = vm.serializeString(section, versionStr, _serializeSubVerifierEntry(versionStr, deployed));

    _writeToAddresses(section, sectionJson);
  }

  /// One sub_verifier_versions entry: { address, admin, root_verifier, deployed_at, proof_verifiers }.
  struct SubVerifierEntry {
    address subVerifier;
    address admin;
    address rootVerifier;
    uint256 deployedAt;
    address[] outerVerifiers;
  }

  function _serializeSubVerifierEntry(string memory version, SubVerifierEntry memory entry)
    internal
    returns (string memory)
  {
    // proof_verifiers object keyed by outer_count_N
    string memory proofVerifiersKey = string.concat("proof_verifiers_", version);
    string memory proofVerifiersJson;
    for (uint256 i = 0; i < 10; i++) {
      proofVerifiersJson = vm.serializeAddress(
        proofVerifiersKey, string.concat("outer_count_", vm.toString(i + 4)), entry.outerVerifiers[i]
      );
    }

    string memory entryKey = string.concat("sub_verifier_", version);
    vm.serializeAddress(entryKey, "address", entry.subVerifier);
    vm.serializeAddress(entryKey, "admin", entry.admin);
    vm.serializeAddress(entryKey, "root_verifier", entry.rootVerifier);
    vm.serializeUint(entryKey, "deployed_at", entry.deployedAt);
    return vm.serializeString(entryKey, "proof_verifiers", proofVerifiersJson);
  }

  function _readSubVerifierEntry(string memory addresses, string memory entryPath)
    internal
    pure
    returns (SubVerifierEntry memory entry)
  {
    _requireFieldCount(addresses, entryPath, 5);
    _requireFieldCount(addresses, string.concat(entryPath, ".proof_verifiers"), 10);

    entry.subVerifier = vm.parseJsonAddress(addresses, string.concat(entryPath, ".address"));
    entry.admin = vm.parseJsonAddress(addresses, string.concat(entryPath, ".admin"));
    entry.rootVerifier = vm.parseJsonAddress(addresses, string.concat(entryPath, ".root_verifier"));
    entry.deployedAt = vm.parseJsonUint(addresses, string.concat(entryPath, ".deployed_at"));

    entry.outerVerifiers = new address[](10);
    for (uint256 i = 0; i < 10; i++) {
      entry.outerVerifiers[i] =
        vm.parseJsonAddress(addresses, string.concat(entryPath, ".proof_verifiers.outer_count_", vm.toString(i + 4)));
    }
  }

  function _versionString(bytes32 version) internal pure returns (string memory) {
    if (version == bytes32(0)) return "unversioned";
    uint256 v = uint256(version);
    return string.concat(
      vm.toString(uint16(v >> 240)), ".", vm.toString(uint16(v >> 224)), ".", vm.toString(uint16(v >> 208))
    );
  }
}
